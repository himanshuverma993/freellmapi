# ── Repo-side configuration ─────────────────────────────────────────────────
# Copy to the repository root as `.env` (or merge into your existing one) when
# the client's LLM_BASE_URL is http://127.0.0.1:8787/v1.

# Required: 64-char hex key. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY

# The port the example client config points at.
PORT=8787

# Localhost only. Use 0.0.0.0 (or leave unset for dual-stack '::') only on a
# trusted network — the proxy is single-user, guarded by the unified API key.
HOST=127.0.0.1

# Model-id aliases (see README.md in this folder). One line of JSON.
# Free install (bundled snapshot):
FREEAPI_MODEL_ALIASES={"zai-org/GLM-5.3:together":"glm-5.1","zai-org/GLM-5.3-Flash:together":"glm-4.7-flash","moonshotai/Kimi-K3:cerebras":"kimi-k2.6","deepseek-ai/DeepSeek-V4-Pro:fireworks-ai":"deepseek-v4-pro"}
# Live/Premium catalog instead:
# FREEAPI_MODEL_ALIASES={"zai-org/GLM-5.3:together":"glm-5.3","zai-org/GLM-5.3-Flash:together":"glm-5.3-flash","moonshotai/Kimi-K3:cerebras":"moonshotai/Kimi-K3","deepseek-ai/DeepSeek-V4-Pro:fireworks-ai":"deepseek-ai/DeepSeek-V4-Pro"}

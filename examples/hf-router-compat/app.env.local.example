# ── App-side configuration (the client that calls an LLM) ────────────────────
# Both variants use the SAME model ids; only the base URL and key change.
# Pick one block, drop it into your app's .env.local.

# ── Variant A: local FreeLLMAPI router (no provider credits needed) ──────────
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:8787/v1
LLM_API_KEY=freellmapi-REPLACE_WITH_YOUR_UNIFIED_KEY
LLM_MODEL=zai-org/GLM-5.3:together
LLM_FALLBACK_MODELS=moonshotai/Kimi-K3:cerebras,deepseek-ai/DeepSeek-V4-Pro:fireworks-ai
LLM_ENHANCER_MODEL=zai-org/GLM-5.3-Flash:together

# ── Variant B: HuggingFace Inference Providers router (direct) ───────────────
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_xxx
# LLM_MODEL=zai-org/GLM-5.3:together
# LLM_FALLBACK_MODELS=moonshotai/Kimi-K3:cerebras,deepseek-ai/DeepSeek-V4-Pro:fireworks-ai
# LLM_ENHANCER_MODEL=zai-org/GLM-5.3-Flash:together

# ── Variant C: local router, router chooses the model ────────────────────────
# Simplest and most resilient: the ids above resolve through the alias map, but
# `auto` needs no aliases at all and still fails over across every provider you
# have a key for. Use the model ids only when the app needs a specific family.
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:8787/v1
# LLM_API_KEY=freellmapi-REPLACE_WITH_YOUR_UNIFIED_KEY
# LLM_MODEL=auto
# LLM_FALLBACK_MODELS=auto
# LLM_ENHANCER_MODEL=auto
